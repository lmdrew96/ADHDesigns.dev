# Resend API key — used by /api/chat to email contact-form submissions
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender domain on Resend (e.g. "ADHDesigns <noreply@adhdesigns.dev>").
# Until your domain is verified, you can use "onboarding@resend.dev" for testing.
CHAT_CONTACT_FROM=ADHDesigns <noreply@adhdesigns.dev>

# Anthropic API key — used by /api/chat for the portfolio assistant (Claude Haiku).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where chatbot contact-form submissions are emailed. Defaults to nae@adhdesigns.dev.
CHAT_CONTACT_TO=nae@adhdesigns.dev

# Optional: refresh the /mcp page's tool lists from the live servers (pnpm mcp:snapshot, also runs before build).
# Each is your personal MCP URL for that server, token included however the server takes it.
# Unset servers keep their snapshot in data/mcp-tools.json. Add MCP_TOKEN_<NAME> for bearer-token servers.
# MCP_URL_CONTROLLEDCHAOS=
# MCP_URL_CHAOSPATCH=
# MCP_URL_KINDLING=
# MCP_URL_TANGLE=
# MCP_URL_THREADNOTES=
# MCP_URL_LOOSE_CHANGE=
# MCP_URL_FOLIO=
# MCP_URL_PERSONAL_CONTEXT=
# MCP_URL_LIBRALEX=
# MCP_URL_SCRIBECAT=
# MCP_URL_VERTEX=
# MCP_URL_CHAOSLINGUA_LITE=
# MCP_TOKEN_CHAOSLINGUA_LITE=
